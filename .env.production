# ==============================================
# PRODUCCION - Ludoteca
# ==============================================
# Rellena TU_DOMINIO con tu dominio real (ej: ludoteca.midominio.com)
# Rellena CAMBIA_ESTA_PASSWORD con una contrasena segura para MySQL

# --- Dominio ---
DOMAIN=TU_DOMINIO

# --- Laravel App ---
APP_NAME=Ludoteca
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://TU_DOMINIO

LOG_CHANNEL=stack
LOG_LEVEL=error

# --- Database ---
DB_CONNECTION=central
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=ludoteca
DB_USERNAME=root
DB_PASSWORD=CAMBIA_ESTA_PASSWORD

# --- Session / Auth ---
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_DOMAIN=.TU_DOMINIO

SANCTUM_STATEFUL_DOMAINS=TU_DOMINIO

CORS_ALLOWED_ORIGINS=https://TU_DOMINIO

# --- Tenancy ---
CENTRAL_DOMAINS=TU_DOMINIO

# --- Frontend URLs (usadas en docker-compose.prod.yml build args) ---
VITE_API_URL=https://TU_DOMINIO/api
VITE_BACKEND_URL=https://TU_DOMINIO
